WITH buckets AS (
    SELECT id, s.start_node % 2 AS bucket, array_agg(s.start_node) AS start_nodes
    FROM t_paths, unnest(t_paths.start_nodes) s(start_node)
    WHERE id = 1
    GROUP BY id, s.start_node % 2
)
SELECT t_paths.id, f.path
FROM t_paths
JOIN buckets USING (id),
     celonis_object_link_extract_paths_v2(t_paths.adj_matrix, buckets.start_nodes, t_paths.end_nodes, NULL, NULL) f(path, path_length, resume_node)
WHERE t_paths.id = 1
