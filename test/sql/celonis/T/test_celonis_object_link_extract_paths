WITH prefixes AS (
    SELECT id,
           array_agg(f.resume_node) AS next_start_nodes
    FROM t_paths, celonis_object_link_extract_paths_v2(t_paths.adj_matrix, t_paths.start_nodes, t_paths.end_nodes, NULL, 'N:PC2') f(path, path_length, resume_node)
    WHERE id = 4 AND f.resume_node IS NOT NULL
    GROUP BY id
)
SELECT t_paths.id, g.path
FROM t_paths
JOIN prefixes USING (id),
     celonis_object_link_extract_paths_v2(t_paths.adj_matrix, prefixes.next_start_nodes, t_paths.end_nodes, NULL, 'N') g(path, path_length, resume_node)
WHERE t_paths.id = 4
ORDER BY t_paths.id, g.path;

WITH prefixes AS (
    SELECT id,
           array_agg(f.resume_node) AS next_start_nodes,
           array_agg(f.path)        AS visited_nodes
    FROM t_paths, celonis_object_link_extract_paths_v2(t_paths.adj_matrix, t_paths.start_nodes, t_paths.end_nodes, NULL, 'N:PC2') f(path, path_length, resume_node)
    WHERE id = 4 AND f.resume_node IS NOT NULL
    GROUP BY id
)
SELECT t_paths.id, g.path
FROM t_paths
JOIN prefixes USING (id),
     celonis_object_link_extract_paths_v2(t_paths.adj_matrix, prefixes.next_start_nodes, t_paths.end_nodes, NULL, 'N', prefixes.visited_nodes) g(path, path_length, resume_node)
WHERE t_paths.id = 4
ORDER BY t_paths.id, g.path;

