-- name: testCelonisArrayLagWindow
create table t (
    id int,
    p string,
    value array<int>
) engine=olap
primary key(id)
distributed by hash(id)
properties("replication_num"="1");

insert into t (id, p, value) values
    (1, 'A', [4]),
    (2, 'A', [4, 5, 6]),
    (3, 'A', []),
    (4, 'A', [NULL]),
    (5, 'A', NULL),
    (6, 'A', [NULL, 1, 2, 3]),
    (7, 'A', [10, NULL, 11, 12, NULL, 13]),
    (8, 'B', [100, 200]),
    (9, 'C', []);

select p, id, value, celonis_array_lag_window(value, 0) over (partition by p order by id) from t order by p, id;
select p, id, value, celonis_array_lag_window(value, 1) over (partition by p order by id rows between unbounded preceding and current row) from t order by p, id;
select p, id, value, celonis_array_lag_window(value, 5000000) over (partition by p order by id) from t order by p, id;

select p, id, value, celonis_array_lag_window(value, 1) over (partition by p order by id) from t order by p, id;
select p, id, value, celonis_array_lag_window(value, 2) over (partition by p order by id) from t order by p, id;
select p, id, value, celonis_array_lag_window(value, 10) over (partition by p order by id) from t order by p, id;
select p, id, value, celonis_array_lag_window(value, 11) over (partition by p order by id) from t order by p, id;

select p, id, value, celonis_array_lag_window(array_map(x -> cast(x as string), value), 1) over (partition by p order by id) from t order by p, id;
