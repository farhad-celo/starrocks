-- name: test_celonis_linear_interpolate_window_function
DROP TABLE IF EXISTS `celonis_linear_interpolate_test`;
CREATE TABLE IF NOT EXISTS `celonis_linear_interpolate_test` (
  id INT NOT NULL,
  seq INT NOT NULL,
  val_bigint BIGINT NULL,
  val_double DOUBLE NULL
)
ENGINE = olap
DUPLICATE KEY(id, seq)
DISTRIBUTED BY HASH(`id`)
PROPERTIES (
  "replication_num" = "1"
);

INSERT INTO `celonis_linear_interpolate_test` VALUES
  -- id=1: no nulls – passthrough
  (1, 1, 10,   1.0),
  (1, 2, 20,   2.0),
  (1, 3, 30,   3.0),
  (1, 4, 40,   4.0),
  -- id=2: single null gap
  (2, 1,  2,   1.5),
  (2, 2, null, null),
  (2, 3,  8,   2.0),
  -- id=3: leading nulls back-filled + trailing null forward-filled
  (3, 1, null, null),
  (3, 2, null, null),
  (3, 3,  5,   5.0),
  (3, 4, null, null),
  -- id=4: all nulls – output must be all NULL
  (4, 1, null, null),
  (4, 2, null, null),
  (4, 3, null, null),
  -- id=5: two independent null gaps (multiple null segments)
  (5, 1,  1,   1.0),
  (5, 2, null, null),
  (5, 3,  3,   3.0),
  (5, 4, null, null),
  (5, 5,  5,   5.0),
  -- id=6: trailing nulls only – forward-fill last known value
  (6, 1, 10,  10.0),
  (6, 2, null, null),
  (6, 3, null, null),
  (6, 4, null, null),
  -- id=7: leading nulls only – back-fill from the single non-null at the end
  (7, 1, null, null),
  (7, 2, null, null),
  (7, 3, 42,  42.0);

-- Test 1: BIGINT input, PARTITION BY id ORDER BY seq
-- Covers: no-nulls passthrough, single-gap interpolation, leading/trailing
-- back/forward fill, all-null partition, multiple independent gaps.
SELECT id, seq,
       CELONIS_LINEAR_INTERPOLATE(val_bigint) OVER (PARTITION BY id ORDER BY seq) AS interp
FROM celonis_linear_interpolate_test
ORDER BY id, seq;

-- Test 2: DOUBLE input, PARTITION BY id ORDER BY seq
-- Same patterns as Test 1;
SELECT id, seq,
       CELONIS_LINEAR_INTERPOLATE(val_double) OVER (PARTITION BY id ORDER BY seq) AS interp
FROM celonis_linear_interpolate_test
ORDER BY id, seq;

-- Test 3: BIGINT, no PARTITION BY, ORDER BY only
-- Single gap between two anchors; the whole result set is one partition.
SELECT seq,
       CELONIS_LINEAR_INTERPOLATE(val) OVER (ORDER BY seq) AS interp
FROM (
    SELECT 1 AS seq, CAST(2  AS BIGINT) AS val UNION ALL
    SELECT 2,        CAST(NULL AS BIGINT)       UNION ALL
    SELECT 3,        CAST(8  AS BIGINT)
) t
ORDER BY seq;

-- Test 4: DOUBLE, no PARTITION BY, ORDER BY only
SELECT seq,
       CELONIS_LINEAR_INTERPOLATE(val) OVER (ORDER BY seq) AS interp
FROM (
    SELECT 1 AS seq, CAST(1.5 AS DOUBLE) AS val UNION ALL
    SELECT 2,        CAST(NULL AS DOUBLE)        UNION ALL
    SELECT 3,        CAST(2.0 AS DOUBLE)
) t
ORDER BY seq;

-- Test 5: PARTITION BY id ORDER BY seq, inline data
-- id=1: leading null, two-null gap, trailing null (all patterns in one partition).
-- id=2: all-null partition.
SELECT id, seq,
       CELONIS_LINEAR_INTERPOLATE(val) OVER (PARTITION BY id ORDER BY seq) AS interp
FROM (
    SELECT 1 AS id, 1 AS seq, CAST(NULL AS BIGINT) AS val UNION ALL
    SELECT 1,        2,        CAST(4  AS BIGINT)         UNION ALL
    SELECT 1,        3,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 1,        4,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 1,        5,        CAST(10 AS BIGINT)         UNION ALL
    SELECT 1,        6,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 2,        1,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 2,        2,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 2,        3,        CAST(NULL AS BIGINT)
) t
ORDER BY id, seq;

-- Test 6: No PARTITION BY, ORDER BY seq only, leading+gap+trailing
-- Two leading nulls, then 10, one null, then 20, one trailing null.
SELECT seq,
       CELONIS_LINEAR_INTERPOLATE(val) OVER (ORDER BY seq) AS interp
FROM (
    SELECT 1 AS seq, CAST(NULL AS BIGINT) AS val UNION ALL
    SELECT 2,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 3,        CAST(10   AS BIGINT)        UNION ALL
    SELECT 4,        CAST(NULL AS BIGINT)        UNION ALL
    SELECT 5,        CAST(20   AS BIGINT)        UNION ALL
    SELECT 6,        CAST(NULL AS BIGINT)
) t
ORDER BY seq;

-- Test 7: GROUP BY – aggregate interpolated values per partition
-- Wraps the window result in a MIN aggregate to verify GROUP BY compatibility.
SELECT id, MIN(interp) AS min_interp
FROM (
    SELECT id,
           CELONIS_LINEAR_INTERPOLATE(val_bigint) OVER (PARTITION BY id ORDER BY seq) AS interp
    FROM celonis_linear_interpolate_test
) t
GROUP BY id
ORDER BY id;

DROP TABLE IF EXISTS `celonis_linear_interpolate_test`;
