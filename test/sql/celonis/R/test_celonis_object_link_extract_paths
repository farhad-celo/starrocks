WITH buckets AS (
    SELECT id, 0 AS bucket, array_agg(s.start_node) AS start_nodes
    FROM t_paths, unnest(t_paths.start_nodes) s(start_node)
    WHERE id = 1
    GROUP BY id
    UNION ALL
    SELECT id, CAST(s.start_node + 1 AS INT) AS bucket, array_agg(s.start_node) AS start_nodes
    FROM t_paths, unnest(t_paths.start_nodes) s(start_node)
    WHERE id = 1
    GROUP BY id, s.start_node
)
SELECT t_paths.id, buckets.bucket, f.path, f.resume_node
FROM t_paths
JOIN buckets USING (id),
     celonis_object_link_extract_paths_v2(t_paths.adj_matrix, buckets.start_nodes, t_paths.end_nodes, NULL, 'N:PC2') f(path, path_length, resume_node)
WHERE t_paths.id = 1
ORDER BY t_paths.id, buckets.bucket, f.path;
