{
    "name": "sr-dev-homcc",
    "containerUser": "root",
    "remoteUser": "root",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/celostar-starrocks,type=bind",
    "workspaceFolder": "/root/celostar-starrocks",
    "build": {
        "dockerfile": "../../docker/dockerfiles/dev-env-homcc-base/x86/Dockerfile",
        "context": "../../docker/dockerfiles/dev-env-homcc-base/x86"
    },
    "postCreateCommand": "cp .devcontainer/CMakePresets.json be/CMakePresets.json",
    "containerEnv": {
        // This is covered by the CMake presets already but still useful to have in case you want to execute build.sh
        "STARROCKS_GCC_HOME": "/usr/",
        "LD_LIBRARY_PATH": "/var/local/thirdparty/installed/jemalloc/lib-shared:/var/local/thirdparty/installed/lib:/usr/lib/jvm/java-17-openjdk-amd64/lib/server",
        "STARROCKS_LINKER": "lld",
        "CMAKE_GENERATOR": "ninja",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "STARROCKS_HOME": "/root/celostar-starrocks",
        "UDF_RUNTIME_DIR": "lib/udf-runtime"
    },
    "customizations": {
        "jetbrains": {
            "settings": {
                "com.intellij:app:HttpConfigurable.use_proxy_pac": true
            }
        }
    }
}
